{
	"id": "canvas.notifications",
	"name": "Notifications",
	"version": "1.0.0",
	"apiVersion": 1,
	"description": "The notification server: popups, their actions, the history and the silence switch",
	"settings": {
		"popupSeconds": 5,
		"criticalNeverExpires": true,
		"maxPopups": 4,
		"historyLimit": 50
	},
	"contributes": {
		"surfaces": [
			{
				"id": "popups",
				"entry": "Popups.qml",
				"perOutput": true
			}
		],
		"barWidgets": [
			{
				"id": "bell",
				"entry": "Bell.qml",
				"section": "right",
				"order": 4.5,
				"panel": "history"
			}
		],
		"panels": [
			{
				"id": "history",
				"entry": "HistoryPanel.qml"
			}
		],
		"actions": [
			{
				"id": "dismiss",
				"entry": "Dismiss.qml"
			},
			{
				"id": "dismiss-all",
				"entry": "DismissAll.qml"
			},
			{
				"id": "silence",
				"entry": "Silence.qml"
			}
		]
	}
}
