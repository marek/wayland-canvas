# wayland-canvas, packaged from the local source tree by tools/package-arch.sh
# (ninja -C build package-arch). The source tarball is generated next to this
# file; its checksum is SKIP because it is a local artifact, not a download.
pkgname=wayland-canvas
# pkgver: tools/package-arch.sh sets it from tools/version.sh
pkgver=0
pkgrel=1
pkgdesc='Infinite-canvas Wayland compositor: virtual desktops are dashed frames on an unbounded zoomable canvas'
arch=('x86_64')
license=('Apache-2.0')
options=('!debug')
install=wayland-canvas.install
depends=(
	'cairo'
	'ffmpeg'
	'glib2'
	'json-glib'
	'lcms2'
	'libdisplay-info'
	'libgcc'
	'libglvnd'
	'libinput'
	'librsvg'
	'libstdc++'
	'libxcb'
	'libxkbcommon'
	'mesa'
	'pango'
	'pixman'
	'seatd'
	'sqlite'
	'systemd-libs'
	'wayland'
	'xcb-util-errors'
	'xcb-util-wm'
)
optdepends=('xorg-xwayland: X11 applications'
	'quickshell: the top bar (started automatically when qs is on PATH)'
	'xdg-desktop-portal-wlr: screen sharing and screenshots for apps (Chrome, video calls)')
makedepends=(
	'clang'
	'git'
	'meson'
	'ninja'
	'wayland'
	'wayland-protocols'
	'libdrm'
	'mesa'
	'libinput'
	'seatd'
	'libxkbcommon'
	'pixman'
	'libdisplay-info'
	'hwdata'
	'cairo'
	'pango'
	'librsvg'
	'lcms2'
	'glib2'
	'json-glib'
	'sqlite'
	'systemd-libs'
	'libxcb'
	'xcb-util-errors'
	'xcb-util-wm'
	'xorg-xwayland'
)
source=("wayland-canvas-$pkgver.tar.xz")
sha256sums=('SKIP')

build() {
	cd "$pkgname-$pkgver"
	meson setup build --prefix=/usr --native-file toolchain/llvm.ini -Dbuildtype=release \
		--force-fallback-for=wlroots
	ninja -C build
}

package() {
	cd "$pkgname-$pkgver"
	# wlroots is linked in statically (--force-fallback-for in build(), whatever
	# the machine has installed); its own install artifacts stay out
	DESTDIR="$pkgdir" meson install -C build --skip-subprojects=wlroots
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	packaging/check-lock-pam.sh "$pkgdir"
}
